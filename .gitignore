.DS_Store
.AppleDouble
.LSOverride
._*
Icon
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Logs & Temporary Files
*.log
*.tmp
/tmp/